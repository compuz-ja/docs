{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "iLoan",
  "description": "Documentation for iLoan — the multi-tenant loan origination platform for credit unions.",
  "colors": {
    "primary": "#1E4D8C",
    "light": "#EBF1FA",
    "dark": "#0F2A52"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Get Started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "introduction",
          "quickstart",
          "key-concepts"
        ]
      },
      {
        "group": "Account & Access",
        "icon": "shield-check",
        "pages": [
          "access/signing-in",
          "access/mfa",
          "access/roles-and-permissions",
          "access/inviting-team-members"
        ]
      },
      {
        "group": "Member Management",
        "icon": "users",
        "pages": [
          "members/overview",
          "members/creating-members",
          "members/kyc-verification",
          "members/documents"
        ]
      },
      {
        "group": "Loan Origination",
        "icon": "file-text",
        "pages": [
          "loans/overview",
          "loans/creating-an-application",
          "loans/loan-types",
          "loans/workflow-states"
        ]
      },
      {
        "group": "Departmental Workflows",
        "icon": "git-branch",
        "pages": [
          "workflows/adjudication",
          "workflows/securities",
          "workflows/disbursement",
          "workflows/notifications"
        ]
      },
      {
        "group": "Audit & Compliance",
        "icon": "shield",
        "pages": [
          "compliance/audit-trail",
          "compliance/compliance-export",
          "compliance/data-security"
        ]
      },
      {
        "group": "Administration",
        "icon": "settings",
        "pages": [
          "admin/tenant-setup",
          "admin/rate-tables",
          "admin/loan-products",
          "admin/analytics-dashboards"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Sign In",
      "href": "https://app.iloan.compuzign.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/compuzign",
      "linkedin": "https://linkedin.com/company/compuzign"
    }
  }
