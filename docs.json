{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "CNS",
  "description": "CNS product documentation. The Loan Origination System (LOS) lives here, with room for every Compuzign product that follows.",
  "colors": {
    "primary": "#F59E0B",
    "light": "#FBBF24",
    "dark": "#D97706"
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "directory": "card",
    "tabs": [
      {
        "tab": "LOS",
        "icon": "banknote",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "introduction",
              "quickstart",
              "key-concepts"
            ]
          },
          {
            "group": "Account & access",
            "icon": "shield-check",
            "pages": [
              "access/signing-in",
              "access/mfa",
              "access/roles-and-permissions",
              "access/inviting-team-members",
              "account/your-profile",
              "account/notification-preferences"
            ]
          },
          {
            "group": "Members & KYC",
            "icon": "users",
            "pages": [
              "members/overview",
              "members/creating-members",
              "members/kyc-verification",
              "members/documents",
              "members/bulk-import"
            ]
          },
          {
            "group": "Loan origination",
            "icon": "file-text",
            "pages": [
              "loans/overview",
              "loans/creating-an-application",
              "loans/loan-assignment",
              "loans/loan-types",
              "loans/workflow-states",
              "loans/loan-agreements"
            ]
          },
          {
            "group": "Loan migration",
            "icon": "archive",
            "pages": [
              "migration/overview",
              "migration/workbook"
            ]
          },
          {
            "group": "Adjudication & securities",
            "icon": "gavel",
            "pages": [
              "workflows/adjudication",
              "workflows/securities"
            ]
          },
          {
            "group": "Disbursement",
            "icon": "banknote",
            "pages": [
              "workflows/disbursement",
              "disbursement/payment-methods",
              "disbursement/fees-and-gct",
              "disbursement/saved-payees",
              "disbursement/controls",
              "disbursement/settlement"
            ]
          },
          {
            "group": "Legal documents",
            "icon": "file-check",
            "pages": [
              "legal-documents/overview",
              "legal-documents/signing",
              "legal-documents/templates"
            ]
          },
          {
            "group": "Notifications",
            "icon": "bell",
            "pages": [
              "workflows/notifications"
            ]
          },
          {
            "group": "Audit & compliance",
            "icon": "shield",
            "pages": [
              "compliance/audit-trail",
              "compliance/compliance-export",
              "compliance/data-security"
            ]
          },
          {
            "group": "Administration",
            "icon": "settings",
            "pages": [
              "admin/workspace-setup",
              "admin/workspace-configuration",
              "admin/loan-products",
              "admin/loan-types",
              "admin/rate-tables",
              "admin/fee-schedule",
              "admin/analytics-dashboards",
              "admin/identity-verification-health"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Changelog",
        "href": "/changelog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign In",
      "href": "https://loan.compuzign.com"
    }
