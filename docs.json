{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "CompuZign",
  "description": "Documentation for the CompuZign platform portfolio. ATLAS is the delivery framework; KAIROS, APTOS, OMNIA and ARGOS are the platforms delivered under it.",
  "colors": {
    "primary": "#475569",
    "light": "#94A3B8",
    "dark": "#334155"
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "compuzign.com",
          "icon": "external-link",
          "href": "https://compuzign.com"
        }
      ]
    },
    "directory": "card",
    "products": [
      {
        "product": "ATLAS",
        "icon": "compass",
        "description": "The delivery framework every CompuZign platform is built and run under.",
        "color": {
          "light": "#475569",
          "dark": "#94A3B8"
        },
        "groups": [
          {
            "group": "The framework",
            "icon": "compass",
            "expanded": true,
            "pages": [
              "atlas/overview",
              "atlas/disciplines",
              "atlas/reference-architecture",
              "atlas/engagement-phases"
            ]
          }
        ]
      },
      {
        "product": "KAIROS",
        "icon": "server",
        "description": "Infrastructure as a service: compute, storage, fabric and the cloud-native runtime.",
        "color": {
          "light": "#0E7490",
          "dark": "#22D3EE"
        },
        "groups": [
          {
            "group": "Platform",
            "icon": "server",
            "expanded": true,
            "pages": [
              "kairos/overview",
              "kairos/data-centres",
              "kairos/platform-stack"
            ]
          }
        ]
      },
      {
        "product": "APTOS",
        "icon": "life-buoy",
        "description": "Support as a service: managed services, security operations and the round-the-clock envelope.",
        "color": {
          "light": "#15803D",
          "dark": "#4ADE80"
        },
        "groups": [
          {
            "group": "Service",
            "icon": "life-buoy",
            "expanded": true,
            "pages": [
              "aptos/overview",
              "aptos/service-management"
            ]
          }
        ]
      },
      {
        "product": "OMNIA",
        "icon": "banknote",
        "description": "Digital banking: core banking, loan origination, onboarding and member channels.",
        "color": {
          "light": "#F59E0B",
          "dark": "#FBBF24"
        },
        "tabs": [
          {
            "tab": "Overview",
            "icon": "banknote",
            "pages": [
              "omnia/overview"
            ]
          },
          {
            "tab": "LOS",
            "icon": "file-text",
            "groups": [
              {
                "group": "Get started",
                "icon": "rocket",
                "expanded": true,
                "pages": [
                  "omnia/los/introduction",
                  "omnia/los/quickstart",
                  "omnia/los/key-concepts"
                ]
              },
              {
                "group": "Account & access",
                "icon": "shield-check",
                "pages": [
                  "omnia/los/access/signing-in",
                  "omnia/los/access/mfa",
                  "omnia/los/access/roles-and-permissions",
                  "omnia/los/access/inviting-team-members",
                  "omnia/los/account/your-profile",
                  "omnia/los/account/notification-preferences"
                ]
              },
              {
                "group": "Members & KYC",
                "icon": "users",
                "pages": [
                  "omnia/los/members/overview",
                  "omnia/los/members/creating-members",
                  "omnia/los/members/kyc-verification",
                  "omnia/los/members/documents",
                  "omnia/los/members/bulk-import"
                ]
              },
              {
                "group": "Loan origination",
                "icon": "file-text",
                "pages": [
                  "omnia/los/loans/overview",
                  "omnia/los/loans/creating-an-application",
                  "omnia/los/loans/loan-assignment",
                  "omnia/los/loans/loan-types",
                  "omnia/los/loans/workflow-states",
                  "omnia/los/loans/loan-agreements"
                ]
              },
              {
                "group": "Loan migration",
                "icon": "archive",
                "pages": [
                  "omnia/los/migration/overview",
                  "omnia/los/migration/workbook"
                ]
              },
              {
                "group": "Adjudication & securities",
                "icon": "gavel",
                "pages": [
                  "omnia/los/workflows/adjudication",
                  "omnia/los/workflows/securities"
                ]
              },
              {
                "group": "Disbursement",
                "icon": "banknote",
                "pages": [
                  "omnia/los/workflows/disbursement",
                  "omnia/los/disbursement/payment-methods",
                  "omnia/los/disbursement/fees-and-gct",
                  "omnia/los/disbursement/saved-payees",
                  "omnia/los/disbursement/controls",
                  "omnia/los/disbursement/settlement"
                ]
              },
              {
                "group": "Legal documents",
                "icon": "file-check",
                "pages": [
                  "omnia/los/legal-documents/overview",
                  "omnia/los/legal-documents/signing",
                  "omnia/los/legal-documents/templates"
                ]
              },
              {
                "group": "Notifications",
                "icon": "bell",
                "pages": [
                  "omnia/los/workflows/notifications"
                ]
              },
              {
                "group": "Audit & compliance",
                "icon": "shield",
                "pages": [
                  "omnia/los/compliance/audit-trail",
                  "omnia/los/compliance/compliance-export",
                  "omnia/los/compliance/data-security"
                ]
              },
              {
                "group": "Administration",
                "icon": "settings",
                "pages": [
                  "omnia/los/admin/workspace-setup",
                  "omnia/los/admin/workspace-configuration",
                  "omnia/los/admin/loan-products",
                  "omnia/los/admin/loan-types",
                  "omnia/los/admin/rate-tables",
                  "omnia/los/admin/fee-schedule",
                  "omnia/los/admin/analytics-dashboards",
                  "omnia/los/admin/identity-verification-health"
                ]
              },
              {
                "group": "Release notes",
                "icon": "clock",
                "pages": [
                  "omnia/los/changelog"
                ]
              }
            ]
          }
        ]
      },
      {
        "product": "ARGOS",
        "icon": "database",
        "description": "The enterprise data warehouse: governed reporting, reconciled to the general ledger.",
        "color": {
          "light": "#12355B",
          "dark": "#7FA8D8"
        },
        "tabs": [
          {
            "tab": "Platform",
            "icon": "database",
            "groups": [
              {
                "group": "Get started",
                "icon": "rocket",
                "expanded": true,
                "pages": [
                  "argos/overview",
                  "argos/editions",
                  "argos/reading-a-report"
                ]
              }
            ]
          },
          {
            "tab": "Reports",
            "icon": "table",
            "groups": [
              {
                "group": "Report catalogue",
                "icon": "library",
                "expanded": true,
                "pages": [
                  "argos/reports/overview"
                ]
              },
              {
                "group": "Financial close",
                "icon": "landmark",
                "pages": [
                  "argos/reports/financial/combined-trial-balance"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
